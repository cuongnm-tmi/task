{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G",
                "Ninja",
                "-B",
                "build",
                "-S",
                ".",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DFILAMENT_ROOT=${input:filamentRoot}"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Blender: export GLB",
            "type": "shell",
            "command": "blender.exe",
            "args": [
                "--background",
                "--python",
                "blender\\icon_mode_scene.py",
                "--",
                "--skip-render",
                "--glb-output",
                "assets\\models\\icon_mode_store.glb"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "filamentRoot",
            "type": "promptString",
            "description": "Path to Filament SDK or build root",
            "default": "C:\\dev\\filament\\out\\cmake-release"
        }
    ]
}
